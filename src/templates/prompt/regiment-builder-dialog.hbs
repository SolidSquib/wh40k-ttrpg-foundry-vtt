{{!-- Only War — Regiment Builder Dialog (#151). --}}
{{!-- Walks the 12-point Regiment Creation budget, then the Standard Kit allowance. --}}
{{!-- The option catalog is read from the Only War compendium packs. --}}
<div class="tw-p-5 tw-bg-transparent tw-font-ui tw-text-[#e8e4d9]" data-wh40k-system="ow">

    <div class="tw-mb-3 tw-text-center tw-text-[0.85rem] tw-text-amber-300 tw-italic">
        {{localize "WH40K.OW.Regiment.DialogTitle"}}
    </div>

    {{!-- Saved regiments to start from, and the lock notice --}}
    {{#if presets.length}}
        <div class="tw-flex tw-flex-wrap tw-items-center tw-gap-1.5 tw-mb-3" data-regiment-presets>
            <span class="tw-text-xs tw-uppercase tw-tracking-[0.08em] tw-text-amber-200">{{localize "WH40K.OW.Regiment.Preset.StartFrom"}}</span>
            {{#each presets}}
                <button type="button" data-action="loadPreset" data-preset-id="{{this.id}}" data-selected="{{#if this.selected}}1{{else}}0{{/if}}"
                        class="tw-px-2 tw-py-0.5 tw-rounded tw-border tw-text-xs tw-cursor-pointer {{#if this.selected}}tw-border-amber-400 tw-bg-[rgba(180,120,40,0.25)] tw-text-amber-50{{else}}tw-border-[rgba(180,120,40,0.3)] tw-bg-transparent tw-text-amber-100/80 hover:tw-bg-[rgba(180,120,40,0.1)]{{/if}}">
                    {{#if this.locked}}<i class="fas fa-lock tw-mr-1"></i>{{/if}}{{this.label}}
                </button>
            {{/each}}
        </div>
    {{/if}}
    {{#if locked}}
        <div class="tw-mb-3 tw-px-3 tw-py-1.5 tw-rounded-md tw-border tw-border-amber-500/40 tw-bg-[rgba(180,120,40,0.12)] tw-text-xs tw-text-amber-100" data-regiment-locked>
            <i class="fas fa-lock tw-mr-1"></i>{{localize "WH40K.OW.Regiment.Preset.LockedNotice"}}
        </div>
    {{/if}}

    {{!-- Live Regiment Creation budget readout --}}
    <div class="tw-flex tw-items-center tw-justify-between tw-gap-2 tw-px-3 tw-py-2 tw-mb-1 tw-rounded-md tw-border tw-border-[rgba(180,120,40,0.3)] tw-bg-[rgba(0,0,0,0.25)]"
         data-regiment-budget>
        <span class="tw-text-sm tw-uppercase tw-tracking-[0.06em] tw-text-amber-100">
            {{localize "WH40K.OW.Regiment.Budget.Total"}}
            {{#if budget.refund}}<span class="tw-text-xs tw-normal-case tw-text-emerald-300">(+{{budget.refund}} {{localize "WH40K.OW.Regiment.Budget.Refund"}})</span>{{/if}}
        </span>
        <span class="tw-text-base tw-font-bold tw-tabular-nums {{#if budget.over}}tw-text-red-300{{else}}tw-text-amber-100{{/if}}"
              data-regiment-spent="{{budget.spent}}"
              data-regiment-total="{{budget.total}}">
            {{budget.spent}} / {{budget.total}}
        </span>
    </div>
    <div class="tw-flex tw-items-center tw-justify-between tw-px-3 tw-mb-3 tw-text-xs tw-text-amber-100/70">
        <span>{{localize "WH40K.OW.Regiment.Doctrines.Count" count=doctrines.count max=doctrines.max}}</span>
        <span>{{localize "WH40K.OW.Regiment.Budget.UnspentToKit"}}</span>
    </div>

    {{#if issues.length}}
        <ul class="tw-mb-3 tw-pl-5 tw-text-xs tw-text-amber-200/90 tw-list-disc" data-regiment-issues>
            {{#each issues}}<li>{{this}}</li>{{/each}}
        </ul>
    {{/if}}

    {{!-- Per-category sections --}}
    <div class="tw-flex tw-flex-col tw-gap-2 tw-mb-4">
        {{#each categories}}
            <section class="tw-rounded-md tw-border tw-border-[rgba(180,120,40,0.25)] tw-bg-[rgba(0,0,0,0.2)] tw-overflow-hidden"
                     data-category="{{this.id}}">
                <header class="tw-flex tw-items-center tw-justify-between tw-px-3 tw-py-1.5 tw-bg-[rgba(180,120,40,0.12)] tw-border-b tw-border-[rgba(180,120,40,0.25)]">
                    <span class="tw-text-xs tw-uppercase tw-tracking-[0.08em] tw-text-amber-200">{{localize this.labelKey}}</span>
                    <span class="tw-text-xs tw-font-bold tw-tabular-nums tw-text-amber-100" data-category-cost="{{this.id}}">{{this.spent}}</span>
                </header>
                <div class="tw-p-2 tw-flex tw-flex-col tw-gap-1">
                    {{#if this.options.length}}
                        {{#each this.options}}
                            <button type="button"
                                    data-action="toggleOption"
                                    data-category="{{../this.id}}"
                                    data-option-id="{{this.id}}"
                                    data-option-cost="{{this.cost}}"
                                    data-selected="{{#if this.selected}}1{{else}}0{{/if}}"
                                    {{#if @root.locked}}disabled{{/if}}
                                    class="disabled:tw-cursor-not-allowed tw-flex tw-items-center tw-justify-between tw-px-2 tw-py-1 tw-rounded tw-border tw-cursor-pointer {{#if this.selected}}tw-border-amber-400 tw-bg-[rgba(180,120,40,0.18)] tw-text-amber-100{{else}}tw-border-[rgba(180,120,40,0.2)] tw-bg-transparent tw-text-amber-100/80 hover:tw-bg-[rgba(180,120,40,0.1)]{{/if}}">
                                <span class="tw-text-xs">{{this.label}}</span>
                                <span class="tw-text-xs tw-font-bold tw-tabular-nums tw-text-amber-200">{{this.cost}}</span>
                            </button>
                            {{#if this.selected}}
                                {{#each this.kit}}
                                    <div class="tw-pl-4 tw-text-[0.7rem] tw-text-amber-100/70">• {{this.label}}{{#if (eq this.scope "squad")}} ({{localize "WH40K.OW.Regiment.Kit.PerSquad"}}){{/if}}</div>
                                {{/each}}
                                {{#each this.choices}}
                                    <div class="tw-pl-4 tw-pb-1" data-regiment-choice="{{this.key}}">
                                        <div class="tw-text-[0.7rem] tw-uppercase tw-tracking-[0.05em] tw-text-amber-200/80">
                                            {{this.label}} — {{localize "WH40K.OW.Regiment.Choice.Pick" count=this.count}}
                                        </div>
                                        <div class="tw-flex tw-flex-wrap tw-gap-1 tw-mt-0.5">
                                            {{#each this.options}}
                                                <button type="button"
                                                        data-action="pickChoice"
                                                        data-option-id="{{../optionId}}"
                                                        data-choice-key="{{../key}}"
                                                        data-value="{{this.value}}"
                                                        data-picked="{{#if this.picked}}1{{else}}0{{/if}}"
                                                        {{#unless ../editable}}disabled{{/unless}}
                                                        class="disabled:tw-cursor-not-allowed tw-px-2 tw-py-0.5 tw-rounded tw-border tw-text-[0.72rem] tw-cursor-pointer {{#if this.picked}}tw-border-amber-400 tw-bg-[rgba(180,120,40,0.25)] tw-text-amber-50{{else}}tw-border-[rgba(180,120,40,0.2)] tw-bg-transparent tw-text-amber-100/80 hover:tw-bg-[rgba(180,120,40,0.1)]{{/if}}">
                                                    {{this.label}}
                                                </button>
                                            {{/each}}
                                        </div>
                                    </div>
                                {{/each}}
                            {{/if}}
                        {{/each}}
                    {{else}}
                        <span class="tw-text-xs tw-italic tw-text-amber-100/40 tw-px-1 tw-py-1">
                            {{localize "WH40K.OW.Regiment.NoOptions"}}
                        </span>
                    {{/if}}
                </div>
            </section>
        {{/each}}
    </div>

    {{!-- Favoured Weapons: one Basic and one Heavy for free, one more of a class per purchased kit item --}}
    <section class="tw-rounded-md tw-border tw-border-[rgba(180,120,40,0.25)] tw-bg-[rgba(0,0,0,0.2)] tw-overflow-hidden tw-mb-4" data-regiment-favoured>
        <header class="tw-flex tw-items-center tw-justify-between tw-px-3 tw-py-1.5 tw-bg-[rgba(180,120,40,0.12)] tw-border-b tw-border-[rgba(180,120,40,0.25)]">
            <span class="tw-text-xs tw-uppercase tw-tracking-[0.08em] tw-text-amber-200">{{localize "WH40K.OW.Regiment.Favoured.Title"}}</span>
            <span class="tw-text-[0.7rem] tw-italic tw-text-amber-100/60">{{localize "WH40K.OW.Regiment.Favoured.Hint"}}</span>
        </header>
        <div class="tw-p-2 tw-flex tw-flex-col tw-gap-1.5">
            {{#each favoured}}
                {{#each this.slots}}
                    <label class="tw-flex tw-items-center tw-justify-between tw-gap-2" data-favoured-slot="{{this.weaponClass}}-{{this.index}}">
                        <span class="tw-text-xs tw-text-amber-100">{{localize ../labelKey}}{{#if this.index}} #{{add this.index 1}}{{/if}}</span>
                        <select data-favoured-class="{{this.weaponClass}}" data-slot="{{this.index}}" {{#unless this.editable}}disabled{{/unless}}
                                class="tw-min-w-0 tw-w-64 tw-px-2 tw-py-0.5 tw-rounded tw-border tw-border-[rgba(180,120,40,0.3)] tw-bg-[rgba(0,0,0,0.4)] tw-text-xs tw-text-amber-100 disabled:tw-opacity-50 disabled:tw-cursor-not-allowed">
                            <option value="">{{localize "WH40K.OW.Regiment.Favoured.None"}}</option>
                            {{#each this.options}}
                                <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
                            {{/each}}
                        </select>
                    </label>
                {{/each}}
            {{/each}}
        </div>
    </section>

    {{!-- Standard Kit allowance --}}
    <section class="tw-rounded-md tw-border tw-border-[rgba(180,120,40,0.25)] tw-bg-[rgba(0,0,0,0.2)] tw-overflow-hidden" data-regiment-kit>
        <header class="tw-flex tw-items-center tw-justify-between tw-px-3 tw-py-1.5 tw-bg-[rgba(180,120,40,0.12)] tw-border-b tw-border-[rgba(180,120,40,0.25)]">
            <span class="tw-text-xs tw-uppercase tw-tracking-[0.08em] tw-text-amber-200">{{localize "WH40K.OW.Regiment.Kit.Total"}}</span>
            <span class="tw-text-xs tw-font-bold tw-tabular-nums {{#if kit.over}}tw-text-red-300{{else}}tw-text-amber-100{{/if}}"
                  data-kit-spent="{{kit.spent}}" data-kit-total="{{kit.allowance}}">{{kit.spent}} / {{kit.allowance}}</span>
        </header>
        <div class="tw-p-2 tw-flex tw-flex-col tw-gap-1">
            {{#each kit.rows}}
                <div class="tw-flex tw-items-center tw-justify-between tw-gap-2 tw-px-2 tw-py-0.5 tw-rounded {{#if this.count}}tw-bg-[rgba(180,120,40,0.15)]{{/if}}" data-kit-option="{{this.id}}">
                    <span class="tw-text-xs tw-text-amber-100">
                        {{this.label}}
                        {{#if this.restriction}}<span class="tw-text-[0.65rem] tw-italic tw-text-amber-100/50"> — {{this.restriction}}</span>{{/if}}
                        {{#if this.blocked}}<span class="tw-ml-1 tw-text-[0.65rem] tw-italic tw-text-amber-100/50" data-kit-blocked>{{localize "WH40K.OW.Regiment.Kit.NeedsWeapon"}}</span>{{/if}}
                        {{#if this.limited}}
                            <span class="tw-ml-1 tw-px-1 tw-rounded tw-text-[0.6rem] tw-uppercase tw-tracking-wide {{#if this.atLimit}}tw-bg-[rgba(180,120,40,0.35)] tw-text-amber-200{{else}}tw-bg-[rgba(180,120,40,0.15)] tw-text-amber-100/70{{/if}}" data-kit-limit>
                                {{#if this.once}}{{localize "WH40K.OW.Regiment.Kit.OnceOnly"}}{{else}}{{localize "WH40K.OW.Regiment.Kit.MaxTimes" count=this.maxCount}}{{/if}}
                            </span>
                        {{/if}}
                    </span>
                    <span class="tw-flex tw-items-center tw-gap-1">
                        <span class="tw-text-xs tw-font-bold tw-tabular-nums tw-text-amber-200">{{this.cost}}</span>
                        <button type="button" data-action="removeKit" data-option-id="{{this.id}}" {{#if @root.locked}}disabled{{else}}{{#unless this.count}}disabled{{/unless}}{{/if}}
                                class="tw-w-5 tw-h-5 tw-leading-none tw-rounded tw-border tw-border-[rgba(180,120,40,0.3)] tw-bg-transparent tw-text-amber-100 disabled:tw-opacity-30">−</button>
                        <span class="tw-w-4 tw-text-center tw-text-xs tw-tabular-nums tw-text-amber-100">{{this.count}}</span>
                        <button type="button" data-action="addKit" data-option-id="{{this.id}}" {{#if @root.locked}}disabled{{else}}{{#if this.atLimit}}disabled{{else}}{{#if this.blocked}}disabled{{/if}}{{/if}}{{/if}}
                                class="disabled:tw-opacity-30 tw-w-5 tw-h-5 tw-leading-none tw-rounded tw-border tw-border-[rgba(180,120,40,0.3)] tw-bg-transparent tw-text-amber-100">+</button>
                    </span>
                </div>
                {{#each this.picks}}
                    <div class="tw-flex tw-items-center tw-gap-2 tw-pl-6 tw-pr-2 tw-pb-1" data-kit-pick-row>
                        <select data-kit-pick data-position="{{this.position}}" {{#unless this.editable}}disabled{{/unless}}
                                class="tw-flex-1 tw-min-w-0 tw-text-xs {{#if this.empty}}tw-border-amber-400{{/if}}">
                            <option value="" {{#if this.empty}}selected{{/if}}>
                                {{#if (eq this.kind "line")}}{{localize "WH40K.OW.Regiment.Kit.PickLine"}}{{else}}{{localize "WH40K.OW.Regiment.Kit.PickItem"}}{{/if}}
                            </option>
                            {{#each this.options}}
                                <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                            {{/each}}
                        </select>
                    </div>
                {{/each}}
            {{else}}
                <span class="tw-text-xs tw-italic tw-text-amber-100/40 tw-px-1 tw-py-1">{{localize "WH40K.OW.Regiment.NoOptions"}}</span>
            {{/each}}
        </div>
    </section>

    {{!-- What the regiment is issued: the Standard Kit and the Favoured Weapons, each its own list --}}
    <div class="tw-grid tw-grid-cols-2 tw-gap-2 tw-mt-4" data-regiment-summary>
        <section class="tw-rounded-md tw-border tw-border-[rgba(180,120,40,0.25)] tw-bg-[rgba(0,0,0,0.2)] tw-overflow-hidden" data-regiment-standard-kit>
            <header class="tw-px-3 tw-py-1.5 tw-bg-[rgba(180,120,40,0.12)] tw-border-b tw-border-[rgba(180,120,40,0.25)]">
                <span class="tw-text-xs tw-uppercase tw-tracking-[0.08em] tw-text-amber-200">{{localize "WH40K.OW.Regiment.StandardKit.Title"}}</span>
            </header>
            <div class="tw-p-2 tw-flex tw-flex-col tw-gap-2">
                {{#each kitGroups}}
                    <div data-kit-group="{{this.id}}">
                        <div class="tw-text-[0.65rem] tw-uppercase tw-tracking-[0.06em] tw-text-amber-300/80">
                            {{#if this.source}}{{this.source}}{{else}}{{localize "WH40K.OW.Regiment.StandardKit.Purchased"}}{{/if}}
                        </div>
                        <ul class="tw-m-0 tw-pl-4 tw-list-disc tw-text-xs tw-text-amber-100/90">
                            {{#each this.lines}}
                                <li>{{this.label}}{{#if (eq this.scope "squad")}} <span class="tw-opacity-60">({{localize "WH40K.OW.Regiment.Kit.PerSquad"}})</span>{{/if}}{{#if this.count}} <span class="tw-opacity-60">×{{this.count}}</span>{{/if}}{{#if this.craftsmanship}} <span class="tw-text-amber-300" data-kit-craftsmanship>— {{#if (eq this.craftsmanship "good")}}{{localize "WH40K.OW.Regiment.Kit.CraftGood"}}{{else}}{{localize "WH40K.OW.Regiment.Kit.CraftBest"}}{{/if}}</span>{{/if}}</li>
                            {{/each}}
                        </ul>
                    </div>
                {{else}}
                    <span class="tw-text-xs tw-italic tw-text-amber-100/40">{{localize "WH40K.OW.Regiment.StandardKit.Empty"}}</span>
                {{/each}}
            </div>
        </section>
        <section class="tw-rounded-md tw-border tw-border-[rgba(180,120,40,0.25)] tw-bg-[rgba(0,0,0,0.2)] tw-overflow-hidden" data-regiment-favoured-list>
            <header class="tw-px-3 tw-py-1.5 tw-bg-[rgba(180,120,40,0.12)] tw-border-b tw-border-[rgba(180,120,40,0.25)]">
                <span class="tw-text-xs tw-uppercase tw-tracking-[0.08em] tw-text-amber-200">{{localize "WH40K.OW.Regiment.Favoured.Title"}}</span>
            </header>
            <ul class="tw-m-0 tw-p-2 tw-list-none tw-flex tw-flex-col tw-gap-1 tw-text-xs tw-text-amber-100/90">
                {{#each favouredList}}
                    <li data-favoured-weapon="{{this.weaponClass}}"><span class="tw-opacity-60">{{localize this.labelKey}}:</span> {{this.name}}</li>
                {{else}}
                    <li class="tw-italic tw-text-amber-100/40">{{localize "WH40K.OW.Regiment.Favoured.NoneChosen"}}</li>
                {{/each}}
            </ul>
        </section>
    </div>

    {{!-- Action buttons --}}
    {{#if presetMode}}
        <div class="tw-flex tw-justify-end tw-mt-3" data-regiment-preset-lock>
            <button type="button" data-action="toggleLocked" data-locked="{{#if presetLocked}}1{{else}}0{{/if}}" title="{{localize 'WH40K.OW.Regiment.Preset.LockedHint'}}"
                    class="tw-inline-flex tw-items-center tw-gap-1.5 tw-px-3 tw-py-1 tw-rounded tw-border tw-text-xs tw-cursor-pointer {{#if presetLocked}}tw-border-amber-400 tw-bg-[rgba(180,120,40,0.25)] tw-text-amber-50{{else}}tw-border-[rgba(180,120,40,0.4)] tw-bg-transparent tw-text-amber-100 hover:tw-bg-[rgba(180,120,40,0.1)]{{/if}}">
                <i class="fas {{#if presetLocked}}fa-lock{{else}}fa-lock-open{{/if}}"></i> {{localize "WH40K.OW.Regiment.Preset.Locked"}}
            </button>
        </div>
    {{/if}}
    {{#if canSavePreset}}
        <div class="tw-flex tw-justify-end tw-mt-3">
            <button type="button" data-action="savePreset" title="{{localize 'WH40K.OW.Regiment.Preset.SaveHint'}}"
                    class="tw-inline-flex tw-items-center tw-gap-1.5 tw-px-3 tw-py-1 tw-rounded tw-border tw-border-[rgba(180,120,40,0.4)] tw-bg-transparent tw-text-xs tw-text-amber-100 tw-cursor-pointer hover:tw-bg-[rgba(180,120,40,0.1)]">
                <i class="fas fa-bookmark"></i> {{localize "WH40K.OW.Regiment.Preset.Save"}}
            </button>
        </div>
    {{/if}}
    <div class="tw-flex tw-gap-2.5 tw-mt-4 tw-pt-4 tw-border-t tw-border-[rgba(180,120,40,0.25)]">
        <button type="button"
                data-action="commitRegiment"
                {{#unless canCommit}}disabled{{/unless}}
                class="tw-flex-1 tw-flex tw-items-center tw-justify-center tw-gap-2 tw-px-5 tw-py-3 tw-border-none tw-rounded-md tw-font-ui tw-text-[0.9rem] tw-font-semibold tw-uppercase tw-tracking-[0.08em] tw-cursor-pointer tw-bg-gradient-to-br tw-from-amber-600 tw-to-amber-900 tw-text-amber-50 tw-shadow-[0_4px_12px_rgba(180,120,40,0.35)] disabled:tw-opacity-50 disabled:tw-cursor-not-allowed">
            <i class="fas fa-check"></i> {{#if presetMode}}{{localize "WH40K.OW.Regiment.Preset.SavePreset"}}{{else}}{{localize "WH40K.OW.Regiment.CommitButton"}}{{/if}}
        </button>
        <button type="button"
                data-action="cancelRegiment"
                class="tw-flex-1 tw-flex tw-items-center tw-justify-center tw-gap-2 tw-px-5 tw-py-3 tw-border tw-border-[rgba(255,255,255,0.15)] tw-rounded-md tw-font-ui tw-text-[0.9rem] tw-font-semibold tw-uppercase tw-tracking-[0.08em] tw-cursor-pointer tw-bg-[rgba(255,255,255,0.05)] tw-text-[rgba(255,255,255,0.7)]">
            <i class="fas fa-times"></i> {{localize "WH40K.OW.Regiment.CancelButton"}}
        </button>
    </div>
</div>
